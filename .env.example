F95_DELAY_MIN=1.0
F95_DELAY_MAX=3.0
# Default incremental crawl (python api.py true) stops early only after this
# many CONSECUTIVE fully-unchanged listing pages, so buried new games (which
# sit deep in the activity-sorted feed) still get reached. Default 3.
F95_EMPTY_PAGE_STOP=3
# Extra retries for a new/refreshed game's game-page fetch before giving up,
# so a transient failure never writes a listing-only row. Default 2.
F95_DETAIL_RETRIES=2
# Refresh-queue worker (f95_refresh_worker.py): seconds between job starts.
REFRESH_INTERVAL=10
REFRESH_IDLE_SLEEP=5
