# MySQL only -- set DB_HOST to your actual server address/IP.
DB_USER=dbwriter
DB_PASSWORD=
DB_NAME=games
DB_HOST=46.202.176.220
F95_USER=mbg36894
F95_PASSWORD=
LC_USER=
LC_PASSWORD=
F95_COOKIE_FILE=f95_cookies.json
PACKAGE_DIR=/var/www/html/packages
ROOT=
F95_DELAY_MIN=1.0
F95_DELAY_MAX=3.0
# Default incremental crawl (python api.py true) stops early only after this
# many CONSECUTIVE fully-unchanged listing pages, so buried new games (which
# sit deep in the activity-sorted feed) still get reached. Default 3.
F95_EMPTY_PAGE_STOP=3
# Extra retries for a new/refreshed game's game-page fetch before giving up,
# so a transient failure never writes a listing-only row. Default 2.
F95_DETAIL_RETRIES=2
# Refresh-queue worker (f95_refresh_worker.py): seconds between job starts.
REFRESH_INTERVAL=10
REFRESH_IDLE_SLEEP=5
email=mbg36894@gmail.com
emailpass=
F95_DEBUG_TS=true

# ---------------------------------------------------------------------------
# Deploy over SFTP (the desktop app's Deploy tab)
# ---------------------------------------------------------------------------
# These are read from here in preference to deploy.json, so the SFTP password
# never has to be written into a second file. Anything set here shows up
# read-only on the Settings tab, labelled "from .env" -- change it here and
# press Reload rather than editing it in the app.
#
# A real environment variable of the same name beats this file.
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
# Leave SFTP_PASSWORD blank and set SFTP_KEY_PATH to use a key / ssh-agent.
# Setting a password and no key path selects password auth automatically.
SFTP_PASSWORD=
SFTP_KEY_PATH=
# Force the auth mode if you need to override the automatic choice: key|password
# SFTP_AUTH=key

# Where each tree is deployed TO on the server. Check these against the server
# before the first deploy:  pm2 show atlas | grep -i 'exec cwd'  and  crontab -l
SCRAPER_DIR=/opt/atlas-scraper
ADMIN_SERVER_DIR=/opt/atlas/server/admin
