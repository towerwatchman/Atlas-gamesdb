# ---------------------------------------------------------------------------
# Atlas Admin backend configuration. Copy to `.env` and fill in.
# Keep .env OUT of git (see .gitignore). Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Database (read/write user, SEPARATE from the read-only apireader) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=atlas_admin
DB_PASSWORD=change-me
DB_NAME=games

# --- Auth ---
# Long random string used to sign login tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# How long a login stays valid.
# How long a login lasts, in hours. 168 = one week.
# This value OVERRIDES the code default -- an existing deployment with
# SESSION_HOURS=12 here will keep expiring after 12h no matter what the
# default says. The effective value is printed at startup.
SESSION_HOURS=168

# --- Server ---
PORT=8787
# Comma-separated list of origins allowed to call the API in dev. In
# production the API and built frontend are served from the same origin, so
# this can stay empty.
CORS_ORIGINS=http://localhost:5173

# --- Seed (used once by `npm run seed`) ---
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=change-me-on-first-login
